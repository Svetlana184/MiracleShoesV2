<Window x:Class="MiracleShoesDesktop.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiracleShoesDesktop.View"
        mc:Ignorable="d"
        Title="Чудо Обувь — Каталог" Height="650" Width="1050"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource MainBackground}">
    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="15" Background="{StaticResource AdditionalBackground}">
            <StackPanel Orientation="Horizontal">
                <Image Source="/Resources/logo.png" Height="80" Stretch="Uniform"/>
                <TextBlock Text="ЧУДО ОБУВЬ" FontSize="50" FontWeight="Bold"
                       VerticalAlignment="Center" Margin="15,0,0,0"/>
                <TextBlock Text="{Binding UserInfo}" FontSize="16" FontStyle="Italic"
                       VerticalAlignment="Center" Margin="30,0,0,0"/>
            </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Left" Width="200" Margin="0,10,0,0">
            <Button Content="Каталог" Height="40" Margin="0,50"
                Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                Command="{Binding ShowCatalogCommand}"/>
            <Button Content="Заказы" Height="40" Margin="0,50"
                Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                Command="{Binding ShowOrdersCommand}"
                Visibility="{Binding ShowOrdersBool, Converter={StaticResource BoolToVis}}"/>
            <Button Content="{Binding AuthorizeButton}" Height="40" Margin="0,100,0,50"
                Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                Command="{Binding LogoutCommand}"/>
        </StackPanel>

        <ContentControl Content="{Binding CurrentView}" Margin="20"/>
    </DockPanel>
</Window>
