<Window x:Class="MiracleShoesDesktop.View.SelectUserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiracleShoesDesktop.View"
        mc:Ignorable="d"
        Title="Выбор клиента" Height="220" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">
    <StackPanel Margin="20">
        <TextBlock Text="Клиент:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox x:Name="UserCombo" DisplayMemberPath="FullName" Height="30"/>
        <Button Content="OK" Width="120" Height="32" Margin="0,20,0,0" HorizontalAlignment="Right"
                Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                Click="Ok_Click"/>
    </StackPanel>
</Window>
