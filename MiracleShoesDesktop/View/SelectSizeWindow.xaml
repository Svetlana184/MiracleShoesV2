<Window x:Class="MiracleShoesDesktop.View.SelectSizeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:MiracleShoesDesktop.View"
        mc:Ignorable="d"
        Title="Выбор размера и количества" Height="320" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource MainBackground}">
    <StackPanel Margin="20">
        <TextBlock Text="{Binding ProductName}" FontSize="16" FontWeight="Bold"
                   TextWrapping="Wrap" Margin="0,0,0,10"/>

        <TextBlock Text="Размер:" FontWeight="Bold" Margin="0,0,0,5"/>
        <ComboBox ItemsSource="{Binding Sizes}"
                  SelectedItem="{Binding SelectedSize}"
                  DisplayMemberPath="ShoeSize" Height="28"/>

        <TextBlock Text="Количество:" FontWeight="Bold" Margin="0,15,0,5"/>
        <StackPanel Orientation="Horizontal">
            <Button Content="−" Width="35" Height="30" Command="{Binding MinusCommand}"/>
            <TextBox Width="80" Height="30" Margin="5,0" TextAlignment="Center"
                     Text="{Binding Amount, UpdateSourceTrigger=PropertyChanged}"
                     PreviewTextInput="AmountBox_PreviewTextInput"/>
            <Button Content="+" Width="35" Height="30" Command="{Binding PlusCommand}"/>
            <TextBlock Text="{Binding AvailableText}" VerticalAlignment="Center"
                       Margin="15,0,0,0" Foreground="Gray"/>
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,25,0,0">
            <Button Content="Добавить" Width="120" Height="32" Margin="0,0,10,0"
                    Background="{StaticResource AccentColor}" Foreground="White" FontWeight="Bold"
                    Command="{Binding OkCommand}"/>
            <Button Content="Отмена" Width="100" Height="32"
                    Background="#DDDDDD" Command="{Binding CancelCommand}"/>
        </StackPanel>
    </StackPanel>
</Window>
