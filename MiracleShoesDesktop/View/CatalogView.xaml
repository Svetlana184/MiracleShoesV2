<UserControl x:Class="MiracleShoesDesktop.View.CatalogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MiracleShoesDesktop.View"
             mc:Ignorable="d" 
             d:DesignHeight="500" d:DesignWidth="900">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Margin="0,0,0,15"
                    Visibility="{Binding CanUseFilters, Converter={StaticResource BoolToVis}}">
            <TextBox Width="250" Height="35" Margin="0,0,10,0" VerticalContentAlignment="Center"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Поиск по названию"/>
            <ComboBox Width="160" Height="35" Margin="0,0,10,0"
                      ItemsSource="{Binding SortOptions}"
                      SelectedItem="{Binding SelectedSort}"/>
            <Button Content="Применить" Width="120" Height="35"
                    Background="{StaticResource AccentColor}" Foreground="White"
                    Command="{Binding LoadProductsCommand}"/>
        </StackPanel>

        <ListBox Grid.Row="1" ItemsSource="{Binding Products}"
                 Background="Transparent" BorderThickness="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border BorderBrush="{StaticResource AccentColor}" BorderThickness="1"
                            CornerRadius="8" Padding="15" Margin="0,5"
                            Background="{Binding Amount, Converter={StaticResource LowStockConverter}}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="100"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="170"/>
                            </Grid.ColumnDefinitions>

                            <Image Stretch="Uniform" Height="80" Width="80"
                                   Source="{Binding ExternalUrl, Converter={StaticResource ProductImageConverter}}"/>

                            <StackPanel Grid.Column="1" Margin="15,0">
                                <TextBlock Text="{Binding NameProduct}" FontSize="18" FontWeight="Bold"/>
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="{Binding Category}"/>
                                    <Run Text=" / "/>
                                    <Run Text="{Binding Subcategory}"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Description}" TextWrapping="Wrap"
                                           Foreground="Gray" Margin="0,5"/>
                                <TextBlock FontSize="12" Foreground="Gray"
                                           Text="{Binding CompanyName, StringFormat='Производство: {0}'}"/>
                                <TextBlock FontSize="12" Foreground="Gray">
                                    <Run Text="Размеры: "/>
                                    <ItemsControl ItemsSource="{Binding Sizes}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate><TextBlock Text="{Binding ShoeSize, StringFormat='{}{0} '}"/></DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>     
                                </TextBlock>
                                <TextBlock FontSize="14" Margin="0,5,0,0">
                                    <Run Text="В наличии: "/>
                                    <Run Text="{Binding Amount}" FontWeight="Bold"/>
                                    <Run Text=" шт."/>
                                </TextBlock>
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding Cost, StringFormat='{}{0:N2} ₽'}"
                                           FontSize="20" FontWeight="Bold"
                                           Foreground="{StaticResource AccentColor}"
                                           HorizontalAlignment="Right"/>
                                <Button Content="В заказ" Height="35" Margin="0,10,0,0" Width="140"
                                        Background="{StaticResource AccentColor}" Foreground="White"
                                        Command="{Binding DataContext.AddToOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}"
                                        Visibility="{Binding DataContext.CanOrder, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVis}}"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
