<Application x:Class="MiracleShoesDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:MiracleShoesDesktop"
             xmlns:services="clr-namespace:MiracleShoesDesktop.Services">
    <Application.Resources>
        <SolidColorBrush x:Key="MainBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="AdditionalBackground" Color="#D2F6E7"/>
        <SolidColorBrush x:Key="AccentColor" Color="#70B2AF"/>
        <SolidColorBrush x:Key="LowStockHighlight" Color="#FF8080"/>

        <Style TargetType="Window">
            <Setter Property="FontFamily" Value="Calibri"/>
            <Setter Property="Background" Value="{StaticResource MainBackground}"/>
        </Style>
        <Style TargetType="Control">
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Calibri"/>
        </Style>

        <services:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <services:LowStockToColorConverter x:Key="LowStockConverter"/>
        <services:ProductImageConverter x:Key="ProductImageConverter"/>  
    </Application.Resources>
</Application>
